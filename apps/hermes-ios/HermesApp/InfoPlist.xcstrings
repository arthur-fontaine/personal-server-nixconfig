{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes lets you send photos you take to your agent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes te permet d’envoyer à ton agent les photos que tu prends."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes uses Face ID to open your private sub-chats."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes utilise Face ID pour ouvrir tes sous-discussions privées."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes uses the microphone in call mode, to talk with your agent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes utilise le micro en mode appel, pour parler avec ton agent."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes lets you send photos and videos to your agent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes te permet d’envoyer des photos et des vidéos à ton agent."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the voice model, calls use Apple's speech recognition, on this device when it can, to turn what you say into messages for Hermes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans le modèle vocal, les appels utilisent la reconnaissance vocale d’Apple, sur cet appareil quand c’est possible, pour transformer ce que tu dis en messages pour Hermes."
          }
        }
      }
    }
  },
  "version": "1.0"
}
