    },
    "Hermes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes"
          }
        }
      }
    },
    "Hermes asks before anything risky, and tells you when long work is done. With AirPods, Siri can read it out.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes demande avant toute action risquée et te prévient quand un long travail est terminé. Avec des AirPods, Siri peut te le lire."
          }
        }
      }
    },
    "Hermes draws it in a few minutes, then rebuilds the app so its icon is your new pet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes le dessine en quelques minutes, puis recompile l’app pour que son icône soit ton nouveau compagnon."
          }
        }
      }
    },
    "Hermes is hatching your pet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes fait éclore ton compagnon"
          }
        }
      }
    },
    "Hermes is opening “%@”": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes ouvre « %@ »"
          }
        }
      }
    },
    "Hermes is rebuilding the app": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes recompile l’app"
          }
        }
      }
    },
    "Hermes is writing": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes écrit"
          }
        }
      }
    },
    "Hermes keeps this sub-chat's memory encrypted. The app sends “/sub unlock” for you and deletes it right after.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes garde la mémoire de cette sous-discussion chiffrée. L’app envoie « /sub unlock » pour toi et le supprime aussitôt."
          }
        }
      }
    },
    "Hermes needs the microphone for calls. Allow it in Settings.": {
