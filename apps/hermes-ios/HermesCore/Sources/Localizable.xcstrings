        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impôts 2026"
          }
        }
      }
    },
    "Taxes moved to a private sub-chat. The reading list began. The nightly backup warned twice about free space on the external disk.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les impôts passent dans une sous-discussion privée. La liste de lecture commence. La sauvegarde nocturne alerte deux fois sur l’espace libre du disque externe."
          }
        }
      }
    },
    "Taxes paperwork listed and moved to a private sub-chat; Hermes keeps nothing of it here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Papiers des impôts listés et passés dans une sous-discussion privée ; Hermes n’en garde rien ici."
          }
        }
      }
    },
    "Telegram isn't connected yet.": {
      "localizations": {
