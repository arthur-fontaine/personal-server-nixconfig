        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait. %@ Rien d’autre ne demande ton attention."
          }
        }
      }
    },
    "Done: a reminder at 19:30 today, in Reminders on your iPhone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est fait : un rappel à 19:30 aujourd’hui, dans Rappels sur ton iPhone."
          }
        }
      }
    },
    "Drafted a line of the form.": {
      "localizations": {
        "fr": {
          "stringUnit": {
