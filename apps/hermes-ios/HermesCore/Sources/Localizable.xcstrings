            "value": "Terminer la sous-discussion"
          }
        }
      }
    },
    "End this sub-chat? Its topic and memory are deleted.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminer cette sous-discussion ? Son sujet et sa mémoire seront supprimés."
