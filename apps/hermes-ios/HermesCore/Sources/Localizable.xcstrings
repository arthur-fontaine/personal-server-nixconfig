      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôtels comparés près d’Alfama ; Arthur choisit celui avec la terrasse."
          }
        }
      }
    },
    "Hour by Hour": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heure par heure"
          }
        }
      }
    },
