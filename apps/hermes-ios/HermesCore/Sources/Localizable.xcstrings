{
  "sourceLanguage": "en",
  "strings": {
    "03:12, restic: no space left on device. Hermes checked the disk: 1.9 of 2 TB used.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "03:12, restic : plus d’espace sur le disque. Hermes vérifie : 1,9 To utilisés sur 2."
