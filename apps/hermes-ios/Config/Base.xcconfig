// Defaults for every build. Override in Config/Local.xcconfig (git-ignored) or on the
// xcodebuild command line (KEY=value), which is what the server does.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

HERMES_TEAM_ID =
HERMES_BUNDLE_ID_PREFIX = dev.hermes.local
// 0: a free personal team (no push, no communication / time-sensitive notifications).
// 1: a paid Apple Developer Program team, which lights up APNs-based features.
HERMES_PAID_TEAM = 0
HERMES_BOT_USERNAME =
// From https://my.telegram.org. Without them the app starts on its demo data.
HERMES_TG_API_ID =
HERMES_TG_API_HASH =
// Optional: an Infomaniak API token makes big files go to SwissTransfer instead of Gofile.
HERMES_SWISSTRANSFER_TOKEN =

HERMES_APP_GROUP = group.$(HERMES_BUNDLE_ID_PREFIX).hermes

// HERMES_PAID_TEAM picks the entitlements file and a compilation condition.
HERMES_ENTITLEMENTS_SUFFIX_0 =
HERMES_ENTITLEMENTS_SUFFIX_1 = -Paid
HERMES_ENTITLEMENTS_SUFFIX = $(HERMES_ENTITLEMENTS_SUFFIX_$(HERMES_PAID_TEAM))
HERMES_PAID_FLAG_0 =
HERMES_PAID_FLAG_1 = HERMES_PAID
HERMES_PAID_FLAG = $(HERMES_PAID_FLAG_$(HERMES_PAID_TEAM))

#include? "Local.xcconfig"
